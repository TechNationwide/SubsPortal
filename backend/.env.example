# Aquamark Broker API — copy to backend/.env and fill in values.
# Do not commit backend/.env (contains secrets).

# --- Test (works immediately with Aquamark branding) ---
AQUAMARK_API_URL=https://aquamark-broker-funder.onrender.com
AQUAMARK_API_KEY=aqua-api-watermark-77204041104282
# Optional — fallback when a brand has no Aquamark email set
# AQUAMARK_USER_EMAIL=christina@aquamark.io

# --- Production (after signup at https://www.aquamark.io/signup) ---
# AQUAMARK_API_KEY=your-production-api-key
# AQUAMARK_USER_EMAIL=your-aquamark-account@company.com

# Optional
AQUAMARK_WATERMARK_TYPE=full
# Rasterize Aquamark output so watermarks are baked in (true | false)
AQUAMARK_FLATTEN=true

# --- SendGrid (required for the Send Email step) ---
# SENDGRID_API_KEY=SG.your-real-key-here

# --- MongoDB (only needed when deployed somewhere with no persistent disk,
# e.g. Render's free tier — leave unset for local dev, which uses the
# data/store.json file instead) ---
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB=subsportal

# --- CORS (comma-separated extra origins to allow, e.g. your Vercel URL) ---
# EXTRA_CORS_ORIGINS=https://your-app.vercel.app

# --- OnDeck Partner API (API Partners tab) — leave unset until the joint
# test session with the client; the tab shows OnDeck as "not configured"
# and 503s before any network call as long as these are unset. ---
# ONDECK_API_BASE_URL=https://stagingpartners.ondeckcapital.com
# ONDECK_USERNAME=your-ondeck-partner-username
# ONDECK_PASSWORD=your-ondeck-partner-password
# ONDECK_API_KEY=your-ondeck-api-key

# --- CAN Capital Partner API (API Partners tab) — leave unset until the
# joint test session with the client; same not-configured/503 gate. ---
# CAN_API_BASE_URL=https://partner-api-sandbox.cancapital.com
# CAN_EMAIL=your-can-partner-email
# CAN_PASSWORD=your-can-partner-password

# --- PEAC Working Capital (API Partners tab) — leave unset until the joint
# test session with the client; same not-configured/503 gate. ---
# PEAC_API_BASE_URL=https://devportal.marlincapitalsolutions.com:8077
# PEAC_USERNAME=your-peac-username
# PEAC_PASSWORD=your-peac-password
# PEAC_API_KEY=your-peac-x-api-key
# PEAC_PARTNER_ID=your-peac-partner-id
# PEAC_BROKER_NUMBER=your-peac-broker-number

# --- Channel Partners (API Partners tab) — leave unset until the joint test
# session with the client; same not-configured/503 gate. ---
# CHANNEL_API_BASE_URL=https://apponboarding.cpcapi.com
# CHANNEL_API_TOKEN=your-channel-bearer-token
# CHANNEL_USER_EMAIL=your-channel-user-email

# --- iDea Financial (API Partners tab) — leave unset until the joint test
# session with the client; same not-configured/503 gate. ---
# IDEA_TOKEN_URL=https://oauth.ideafinancial.com/token
# IDEA_API_BASE_URL=https://partner.api.ideafinancial.com
# IDEA_CLIENT_ID=your-idea-client-id
# IDEA_CLIENT_SECRET=your-idea-client-secret
# IDEA_AGENT_ID=your-idea-agent-id
